---
import Layout from '../layouts/Layout.astro';
import { properties, siteInfo } from '../data/siteData.js';

const categories = ['All', 'Residential', 'Commercial', 'Land & Development'];
---

<Layout title={`Properties & Listings | ${siteInfo.brand}`}>
  <!-- Page Header -->
  <section class="bg-forest text-stone-paper border-b-2 border-ink py-14 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-widest text-stone-warm/75 mb-2">
        {siteInfo.groupName} • Portfolio Launching Soon
      </p>
      <h1 class="font-display text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
        Properties & Listings (Coming Soon)
      </h1>
      <p class="text-stone-warm/85 max-w-2xl text-base sm:text-lg mt-4 leading-relaxed">
        We are currently preparing our online property catalog for <strong>{siteInfo.groupName}</strong>. Browse our upcoming tracks below or contact us directly for current off-market inventory.
      </p>
    </div>
  </section>

  <!-- Filter & Listings Grid -->
  <section class="py-16 bg-stone-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Category Filter Bar -->
      <div class="flex flex-wrap items-center justify-between gap-4 pb-8 mb-10 border-b-2 border-ink">
        <div class="flex flex-wrap gap-2" id="filter-buttons">
          {categories.map((cat, idx) => (
            <button
              type="button"
              data-filter={cat}
              class={`filter-btn px-5 py-2.5 text-xs font-bold uppercase tracking-widest border border-ink transition-colors ${
                idx === 0
                  ? 'bg-forest text-white'
                  : 'bg-white text-ink hover:bg-stone-warm'
              }`}
            >
              {cat}
            </button>
          ))}
        </div>

        <p class="text-xs font-bold uppercase tracking-wider text-ink-muted">
          Showing <span id="property-count" class="text-ink">{properties.length}</span> Properties
        </p>
      </div>

      <!-- Properties Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="properties-grid">
        {properties.map((property) => (
          <article
            data-category={property.category}
            class="property-card border-2 border-ink bg-white flex flex-col justify-between shadow-[6px_6px_0px_0px_#141514] hover:shadow-[8px_8px_0px_0px_#163024] transition-all"
          >
            <div>
              <div class="aspect-[16/10] overflow-hidden border-b-2 border-ink relative bg-stone-warm">
                <img
                  src={property.image}
                  alt={property.title}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                />
                <div class="absolute top-3 left-3 flex gap-2">
                  <span class="bg-ink text-white text-xs font-bold uppercase tracking-wider px-3 py-1">
                    {property.category}
                  </span>
                  <span class="bg-forest text-white text-xs font-bold uppercase tracking-wider px-3 py-1">
                    {property.status}
                  </span>
                </div>
              </div>

              <div class="p-6">
                <div class="flex items-baseline justify-between gap-2 mb-2">
                  <span class="text-xs font-semibold uppercase tracking-wider text-ink-muted">
                    {property.location}
                  </span>
                  <span class="font-display text-xl font-extrabold text-forest">
                    {property.price}
                  </span>
                </div>

                <h2 class="font-display text-xl font-bold text-ink mb-3">
                  {property.title}
                </h2>

                <p class="text-sm text-ink-muted leading-relaxed mb-5">
                  {property.summary}
                </p>
              </div>
            </div>

            <div class="px-6 pb-6 pt-4 border-t border-stone-border bg-stone-paper/50">
              <div class="grid grid-cols-3 gap-2 text-xs font-bold text-ink mb-4">
                <div class="bg-stone-warm px-2.5 py-1.5 border border-stone-border text-center">
                  {property.specs.beds}
                </div>
                <div class="bg-stone-warm px-2.5 py-1.5 border border-stone-border text-center">
                  {property.specs.baths}
                </div>
                <div class="bg-stone-warm px-2.5 py-1.5 border border-stone-border text-center">
                  {property.specs.sqft}
                </div>
              </div>

              <a
                href={`/contact?property=${encodeURIComponent(property.title)}`}
                class="block w-full text-center bg-forest text-white py-3 text-xs font-bold uppercase tracking-widest border border-ink hover:bg-ink transition-colors"
              >
                Get Notified / Inquire Direct
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Off-Market Callout Box -->
      <div class="mt-16 border-2 border-ink bg-stone-warm p-8 sm:p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-forest">
            Off-Market Access
          </span>
          <h3 class="font-display text-2xl font-extrabold text-ink mt-1">
            Don’t See the Exact Property You’re Looking For?
          </h3>
          <p class="text-sm text-ink-muted mt-1 max-w-xl">
            We frequently have homes under renovation and off-market commercial parcels before they are listed publicly. Tell us your criteria and we’ll match you directly.
          </p>
        </div>
        <a
          href="/contact?interest=buy"
          class="bg-ink text-white px-7 py-4 text-xs font-bold uppercase tracking-widest border border-ink hover:bg-forest transition-colors shrink-0"
        >
          Send Your Buyer Criteria →
        </a>
      </div>
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.property-card');
    const countEl = document.getElementById('property-count');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        buttons.forEach((b) => {
          b.classList.remove('bg-forest', 'text-white');
          b.classList.add('bg-white', 'text-ink');
        });
        btn.classList.remove('bg-white', 'text-ink');
        btn.classList.add('bg-forest', 'text-white');

        let visibleCount = 0;
        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'All' || category === filter) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (countEl) countEl.textContent = String(visibleCount);
      });
    });
  </script>
</Layout>
