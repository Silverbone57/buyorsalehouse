---
import Layout from '../layouts/Layout.astro';
import { siteInfo } from '../data/siteData.js';
---

<Layout title={`About & Direct Contact | ${siteInfo.brand}`}>
  <!-- Header Banner -->
  <section class="bg-forest text-stone-paper border-b-2 border-ink py-14 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-widest text-stone-warm/75 mb-2">
        About & Direct Contact
      </p>
      <h1 class="font-display text-4xl sm:text-5xl font-extrabold text-white tracking-tight max-w-3xl">
        Straightforward Real Estate. Direct Conversations.
      </h1>
      <p class="text-stone-warm/85 max-w-2xl text-base sm:text-lg mt-4 leading-relaxed">
        No call centers, no runaround. Reach out directly whether you’re buying a home, selling a property for cash, or proposing a commercial venture.
      </p>
    </div>
  </section>

  <!-- About Story + Contact Form -->
  <section class="py-16 bg-stone-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Left Column: Company Overview & Direct Info -->
      <div class="lg:col-span-5 space-y-8">
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-forest mb-2">
            Our Philosophy
          </p>
          <h2 class="font-display text-3xl font-extrabold text-ink">
            Built on Clear Numbers & Honest Execution
          </h2>
          <p class="text-sm sm:text-base text-ink-muted mt-4 leading-relaxed">
            At <strong>{siteInfo.brand}</strong> (operating with <strong>{siteInfo.groupName}</strong>), we believe real estate doesn’t need to be complicated or buried in corporate fluff. We work across the full lifecycle of residential and commercial properties—buying directly from owners who value speed and certainty, helping families buy and sell quality homes, and partnering on high-potential land and commercial deals.
          </p>
        </div>

        <div class="border-2 border-ink bg-stone-warm p-6 space-y-4">
          <h3 class="font-display text-lg font-extrabold text-ink border-b border-ink pb-2">
            Direct Contact Channels
          </h3>
          <div class="space-y-3 text-sm">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-ink-muted">Real Estate Group</p>
              <p class="font-display text-lg font-bold text-forest">
                {siteInfo.groupName}
              </p>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-ink-muted">Email</p>
              <a href={`mailto:${siteInfo.email}`} class="font-semibold text-ink hover:text-forest underline">
                {siteInfo.email}
              </a>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-ink-muted">Phone</p>
              <p class="font-medium text-ink">Direct Line Coming Soon (Use Contact Form)</p>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-ink-muted">Operating Hours</p>
              <p class="font-medium text-ink">{siteInfo.hours}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Brutalist/Architectural Contact Form -->
      <div class="lg:col-span-7">
        <div class="border-2 border-ink bg-white p-8 sm:p-10 shadow-[8px_8px_0px_0px_#141514]">
          <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-ink mb-2">
            Send a Direct Message
          </h2>
          <p class="text-sm text-ink-muted mb-6">
            Fill out the form below and we’ll respond promptly—usually the same business day.
          </p>

          <form id="contact-form" class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
                  Full Name *
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="Your Name"
                  class="w-full px-4 py-3 bg-stone-paper border border-ink text-sm focus:outline-none focus:ring-2 focus:ring-forest"
                />
              </div>
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
                  Phone or Email *
                </label>
                <input
                  type="text"
                  id="contact-info"
                  name="contact"
                  required
                  placeholder="(555) 000-0000 or email"
                  class="w-full px-4 py-3 bg-stone-paper border border-ink text-sm focus:outline-none focus:ring-2 focus:ring-forest"
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
                What Are You Reaching Out About?
              </label>
              <select
                id="contact-interest"
                name="interest"
                class="w-full px-4 py-3 bg-stone-paper border border-ink text-sm focus:outline-none focus:ring-2 focus:ring-forest"
              >
                <option value="buy">Buying / Touring an Available Property</option>
                <option value="sell">Selling a House or Land Direct for Cash</option>
                <option value="invest">Commercial / Investment / Joint Venture</option>
                <option value="general">General Inquiry</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
                Property of Interest / Subject (Optional)
              </label>
              <input
                type="text"
                id="contact-property"
                name="property"
                placeholder="e.g. The Elmwood Modern Residence, or your property address"
                class="w-full px-4 py-3 bg-stone-paper border border-ink text-sm focus:outline-none focus:ring-2 focus:ring-forest"
              />
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
                Your Message *
              </label>
              <textarea
                name="message"
                rows="4"
                required
                placeholder="How can we help you?"
                class="w-full px-4 py-3 bg-stone-paper border border-ink text-sm focus:outline-none focus:ring-2 focus:ring-forest"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full bg-forest text-white py-4 font-bold text-sm uppercase tracking-widest border border-ink hover:bg-ink transition-colors"
            >
              Send Message →
            </button>

            <div
              id="contact-success"
              class="hidden p-4 bg-forest-tint border border-forest text-forest text-sm font-semibold"
            >
              ✓ Message received! We will get back to you shortly.
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Pre-fill fields if visitor clicked from a specific property or home quick-form
    const params = new URLSearchParams(window.location.search);
    const propParam = params.get('property');
    const interestParam = params.get('interest');
    const nameParam = params.get('name');
    const contactParam = params.get('contact');

    const propInput = document.getElementById('contact-property');
    const interestSelect = document.getElementById('contact-interest');
    const nameInput = document.getElementById('contact-name');
    const contactInput = document.getElementById('contact-info');

    if (propParam && propInput) propInput.value = propParam;
    if (interestParam && interestSelect) interestSelect.value = interestParam;
    if (nameParam && nameInput) nameInput.value = nameParam;
    if (contactParam && contactInput) contactInput.value = contactParam;

    const form = document.getElementById('contact-form');
    const success = document.getElementById('contact-success');
    if (form && success) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        success.classList.remove('hidden');
        form.reset();
      });
    }
  </script>
</Layout>
